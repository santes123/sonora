# Rotación de logs de Sonora.
#
#   sudo cp deploy/logrotate/sonora /etc/logrotate.d/sonora
#   sudo chmod 644 /etc/logrotate.d/sonora
#
# Comprobación: sudo logrotate -d /etc/logrotate.d/sonora

/var/log/nginx/music.antoniogmportfolio.online.*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 `cat /var/run/nginx.pid`
    endscript
}

/var/log/sonora-backup.log /var/log/sonora-maintenance.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
}

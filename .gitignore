# Dependencias
/backend/vendor/
/backend/node_modules/
/frontend/node_modules/

# Entornos y secretos
/backend/.env
/backend/.env.backup
/backend/.env.production
/frontend/.env.local
/frontend/.env.*.local
/login.txt

# Medios y artefactos
/backend/storage/app/private/media/*
!/backend/storage/app/private/media/.gitkeep
/backend/storage/logs/*
/backend/database/*.sqlite
/backend/database/*.sqlite-journal

# Temporales de pruebas locales
/.tmp/
/.backups/

# Claves de despliegue (deploy key SSH y similares)
/.deploy/

# Builds
/frontend/dist/
/frontend/dev-dist/

# Sistema
.DS_Store
Thumbs.db
*.log

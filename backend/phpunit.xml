<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        force="true" evita que el test herede el .env del proceso padre.
        Se declaran dos veces a propósito: PHPUnit escribe `<env>` en $_ENV/getenv(),
        pero Laravel (Dotenv) consulta primero $_SERVER. En Docker el env_file ya
        exporta APP_ENV/DB_*/QUEUE_CONNECTION a $_SERVER, así que hacen falta los
        `<server>` para que el entorno de test gane de verdad.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mariadb" force="true"/>
        <env name="DB_HOST" value="mariadb" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="music_test" force="true"/>
        <env name="DB_USERNAME" value="music" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="MEDIA_X_ACCEL" value="false" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>

        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="mariadb" force="true"/>
        <server name="DB_HOST" value="mariadb" force="true"/>
        <server name="DB_PORT" value="3306" force="true"/>
        <server name="DB_DATABASE" value="music_test" force="true"/>
        <server name="DB_USERNAME" value="music" force="true"/>
        <server name="DB_PASSWORD" value="secret" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="MEDIA_X_ACCEL" value="false" force="true"/>
        <server name="SANCTUM_STATEFUL_DOMAINS" value="localhost" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
    </php>
</phpunit>

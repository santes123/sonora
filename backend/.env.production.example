# Plantilla de producción. Copiar a `.env.production` en el servidor y ajustar.
#
#   cp backend/.env.production.example backend/.env.production
#   chmod 600 backend/.env.production
#
# Este fichero NO se versiona (está en .gitignore): contiene secretos.

APP_NAME=Sonora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://music.antoniogmportfolio.online
FRONTEND_URL=https://music.antoniogmportfolio.online

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Base de datos (contenedor MariaDB, red interna de Docker) ---
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=music
DB_USERNAME=music
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# --- Sesiones / cache / colas ---
SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=music.antoniogmportfolio.online
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=sonora

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Sanctum (SPA same-origin) ---
SANCTUM_STATEFUL_DOMAINS=music.antoniogmportfolio.online,localhost,127.0.0.1
SANCTUM_TOKEN_EXPIRATION=null

# --- Correo ---
MAIL_MAILER=smtp
MAIL_HOST=CAMBIAR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_SMTP_USER
MAIL_PASSWORD=CAMBIAR_SMTP_PASSWORD
MAIL_FROM_ADDRESS="hola@antoniogmportfolio.online"
MAIL_FROM_NAME="${APP_NAME}"

# --- Medios ---
MEDIA_DISK=media
MEDIA_X_ACCEL=true
MEDIA_X_ACCEL_PREFIX=/_media
MEDIA_URL_TTL=360
MEDIA_MAX_UPLOAD_MB=256
MEDIA_COVER_MAX_KB=10240
MEDIA_COVER_MAX_DIMENSION=6000
FFPROBE_BINARY=/usr/bin/ffprobe
FFMPEG_BINARY=/usr/bin/ffmpeg

# --- Google OAuth (desactivado hasta tener credenciales) ---
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# --- Almacenamiento S3/MinIO (futuro) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sonora
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

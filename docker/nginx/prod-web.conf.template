# nginx de producción: sirve la SPA compilada y hace de puerta de entrada a
# la API en Laravel (PHP-FPM) y a los medios privados (X-Accel-Redirect).
#
# Es una PLANTILLA: la imagen oficial de nginx sustituye ${SONORA_APP_HOST} y
# ${SONORA_APP_PORT} por los valores del entorno (ver docker-compose.prod.yml)
# y escribe el resultado en /etc/nginx/conf.d/default.conf.
#
# Topología de referencia (docker-compose.prod.yml):
#   host nginx (TLS)  ->  web (este nginx)  ->  app (PHP-FPM)
# Si el TLS termina en este mismo nginx, `X-Forwarded-Proto` llega vacío y se
# usa $scheme (ver el mapa de más abajo).

map $http_x_forwarded_proto $sonora_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

upstream sonora_app {
    server ${SONORA_APP_HOST}:${SONORA_APP_PORT};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # No anunciar la versión de nginx.
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;
    client_max_body_size 260m;

    include /etc/nginx/snippets/security-headers.conf;

    # --- Compresión (solo texto; el audio/imagen no se comprime) ------------
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json application/javascript text/css text/plain
               application/xml image/svg+xml application/manifest+json;

    # --- API ----------------------------------------------------------------
    # PHP-FPM habla FastCGI (no HTTP): aquí va fastcgi_pass, no proxy_pass.
    location /api/ {
        include /etc/nginx/snippets/sonora-fastcgi.conf;

        # Subidas de audio: sin buffer de la petición y sin límite de tiempo
        # razonable para no cortar la carga de ficheros grandes.
        fastcgi_request_buffering off;
        client_max_body_size 260m;
        fastcgi_read_timeout 600s;
        fastcgi_send_timeout 600s;
    }

    # --- Sanctum (cookie CSRF de la SPA) -------------------------------------
    location /sanctum/ {
        include /etc/nginx/snippets/sonora-fastcgi.conf;
    }

    # --- Health check de Laravel --------------------------------------------
    location = /up {
        include /etc/nginx/snippets/sonora-fastcgi.conf;
        access_log off;
    }

    # --- Medios privados servidos por nginx (X-Accel-Redirect) --------------
    # Laravel responde con la cabecera X-Accel-Redirect y nginx entrega el
    # binario: soporta Range y no consume workers de PHP.
    location ^~ /_media/ {
        internal;
        alias /var/www/html/storage/app/private/media/;

        types {
            audio/mpeg  mp3;
            audio/flac  flac;
            audio/mp4   m4a mp4;
            audio/ogg   ogg opus;
            image/webp  webp;
            image/jpeg  jpg jpeg;
            image/png   png;
        }
        default_type application/octet-stream;
    }

    # --- SPA ----------------------------------------------------------------
    # index.html nunca se cachea: es quien apunta a los assets con hash.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires -1;
    }

    # El service worker debe poder actualizarse en cada visita.
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires -1;
    }

    # Los assets con hash de contenido son inmutables.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(?:woff2?|png|jpg|jpeg|webp|svg|ico)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    # Todo lo demás: la SPA resuelve la ruta en el cliente.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;
}
